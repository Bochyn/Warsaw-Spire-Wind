# Wind-tunnel check, AIJ case A: the block at 24 cells across its width b (b = 32 m, cells of 1.333 m).
# Wall-stress ground (z0 = 2.947e-4 m), Smagorinsky constant 0.12, turbulent inflow from inputs/inflow/inflow_b24.bin
# (made with inflow-calibration.json and a length-scale factor of 2.6). 600 s of spin-up, then 1200 s of averaging,
# an output stage every 100 s. Writes the 3D box (stage means and standard deviations) and x-normal planes.
# Needs the build ./build.sh wall-model -DGROUND_WALL_MODEL. Paths are relative to validation/; see docs/VALIDATION.md.
HM=inputs/block-24-cells/height.u16
HX=744
HY=528
NZ=277
DX_M=1.333333
PX=252
PY=264
ZPED=3
ZHI=30
UREF=0.05
ZREF_M=64
ALPHA=0.173
SAMPLE_SI=1.0
FX_Q=0.0005
FX_U_MAX=0.15
QA=-115
QB=28
QD=500
QF=40
QX=0
WD=1200
SD=600
Z0_M=2.947e-4
T_SI=1800
SPIN_SI=600
FRAMES=18
ANIM_T=0
XST=0,1,2,11,12,59,60,107,108,143,144,155,156,203,204,236,237,239,240,251,252,299,300,371,372
VX0=154
VX1=373
VY0=190
VY1=337
VZ1=110
VOL_TAGGED=1
VOL_M2=1
FX_CS=0.12
INFLOW=inputs/inflow/inflow_b24.bin
