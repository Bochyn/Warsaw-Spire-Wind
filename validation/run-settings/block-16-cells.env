# Wind-tunnel check, AIJ case A: the block at 16 cells across its width b (b = 32 m, cells of 2 m).
# Wall-stress ground (z0 = 2.947e-4 m), Smagorinsky constant 0.12, turbulent inflow from inputs/inflow/inflow_b16.bin
# (made with inflow-calibration.json and a length-scale factor of 2.6). 600 s of spin-up, then 1200 s of averaging,
# an output stage every 100 s. Writes the 3D box (stage means and standard deviations) and x-normal planes.
# Needs the build ./build.sh wall-model -DGROUND_WALL_MODEL. Paths are relative to validation/; see docs/VALIDATION.md.
HM=inputs/block-16-cells/height.u16
HX=496
HY=352
NZ=185
DX_M=2.000000
PX=168
PY=176
ZPED=2
ZHI=20
UREF=0.05
ZREF_M=64
ALPHA=0.173
SAMPLE_SI=1.0
FX_Q=0.0005
FX_U_MAX=0.15
QA=-115
QB=28
QD=500
QF=40
QX=0
WD=1200
SD=600
Z0_M=2.947e-4
T_SI=1800
SPIN_SI=600
FRAMES=18
ANIM_T=0
XST=0,1,2,7,8,39,40,71,72,95,96,103,104,135,136,157,158,159,160,167,168,199,200,247,248
VX0=102
VX1=249
VY0=126
VY1=225
VZ1=74
VOL_TAGGED=1
