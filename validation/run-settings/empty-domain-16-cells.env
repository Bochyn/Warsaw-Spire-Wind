# Wind-tunnel check, AIJ case A: the empty domain (no block) at 16 cells per building width b (b = 32 m, cells of 2 m),
# for judging the approach flow. Wall-stress ground (z0 = 2.947e-4 m), Smagorinsky constant 0.12, turbulent inflow from
# inputs/inflow/inflow_b16.bin. 600 s of spin-up, then 1200 s of averaging, an output stage every 100 s.
# Writes x-normal planes; no 3D box, no rendered frames.
# Needs the build ./build.sh wall-model -DGROUND_WALL_MODEL. Paths are relative to validation/; see docs/VALIDATION.md.
HM=inputs/empty-domain-16-cells/height.u16
HX=496
HY=352
NZ=185
DX_M=2.000000
PX=168
PY=176
ZPED=2
ZHI=20
UREF=0.05
ZREF_M=64
ALPHA=0.173
SAMPLE_SI=1.0
FX_Q=0.0005
FX_U_MAX=0.15
QA=-115
QB=28
QD=500
QF=40
QX=0
WD=1200
SD=600
Z0_M=2.947e-4
T_SI=1800
SPIN_SI=600
FRAMES=18
ANIM_T=0
RENDER=0
XST=0,1,2,7,8,39,40,71,72,95,96,103,104,135,136,157,158,159,160,167,168,199,200,247,248
FX_CS=0.12
INFLOW=inputs/inflow/inflow_b16.bin
