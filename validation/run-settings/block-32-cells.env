# Wind-tunnel check, AIJ case A: the block at 32 cells across its width b (b = 32 m, cells of 1 m).
# Wall-stress ground (z0 = 2.947e-4 m), Smagorinsky constant 0.12, turbulent inflow from inputs/inflow/inflow_b32.bin
# (made with inflow-calibration.json and a length-scale factor of 2.6). 600 s of spin-up, then 1200 s of averaging,
# an output stage every 100 s. Writes the 3D box (stage means and standard deviations) and x-normal planes.
# Needs the build ./build.sh wall-model -DGROUND_WALL_MODEL. Paths are relative to validation/; see docs/VALIDATION.md.
HM=inputs/block-32-cells/height.u16
HX=992
HY=704
NZ=369
DX_M=1.000000
PX=336
PY=352
ZPED=4
ZHI=40
UREF=0.05
ZREF_M=64
ALPHA=0.173
SAMPLE_SI=1.0
FX_Q=0.0005
FX_U_MAX=0.15
QA=-115
QB=28
QD=500
QF=40
QX=0
WD=1200
SD=600
Z0_M=2.947e-4
T_SI=1800
SPIN_SI=600
FRAMES=18
ANIM_T=0
FX_CS=0.12
XST=0,1,2,15,16,79,80,143,144,191,192,207,208,271,272,315,316,319,320,335,336,399,400,495,496
VX0=206
VX1=497
VY0=254
VY1=449
VZ1=146
VOL_TAGGED=1
VOL_M2=1
INFLOW=inputs/inflow/inflow_b32.bin
