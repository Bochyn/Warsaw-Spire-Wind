# Wind-tunnel check, AIJ case A: the empty domain (no block) at 24 cells per building width b (b = 32 m, cells of 1.333 m),
# for judging the approach flow. Wall-stress ground (z0 = 2.947e-4 m), Smagorinsky constant 0.12, turbulent inflow from
# inputs/inflow/inflow_b24.bin. 600 s of spin-up, then 1200 s of averaging, an output stage every 100 s.
# Writes x-normal planes; no 3D box, no rendered frames.
# Needs the build ./build.sh wall-model -DGROUND_WALL_MODEL. Paths are relative to validation/; see docs/VALIDATION.md.
HM=inputs/empty-domain-24-cells/height.u16
HX=744
HY=528
NZ=277
DX_M=1.333333
PX=252
PY=264
ZPED=3
ZHI=30
UREF=0.05
ZREF_M=64
ALPHA=0.173
SAMPLE_SI=1.0
FX_Q=0.0005
FX_U_MAX=0.15
QA=-115
QB=28
QD=500
QF=40
QX=0
WD=1200
SD=600
Z0_M=2.947e-4
T_SI=1800
SPIN_SI=600
FRAMES=18
ANIM_T=0
XST=0,1,2,11,12,59,60,107,108,143,144,155,156,203,204,236,237,239,240,251,252,299,300,371,372
FX_CS=0.12
INFLOW=inputs/inflow/inflow_b24.bin
RENDER=0
